# Auto detect text files and normalize line endings to LF
* text=auto

# TypeScript and JavaScript files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf

# CSS and style files
*.css text eol=lf
*.scss text eol=lf

# Other files
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
